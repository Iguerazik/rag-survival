# RAG SURVIVAL — variáveis de ambiente (copie para .env só no seu PC; nunca envie .env ao Git)

# Porta HTTP. No Railway ela é definida automaticamente: não crie PORT lá.
PORT=3001
# Interface de rede. 0.0.0.0 = aceita conexões externas (necessário em hospedagem).
HOST=0.0.0.0

# Simulação do servidor (ticks por segundo) e frequência dos snapshots enviados pela rede.
TICK_RATE=60
SNAPSHOT_RATE=20

# Pasta do banco de contas (SQLite). No Railway: /data (volume persistente montado em /data).
DATA_DIR=./data

# 1 quando o HTTPS é terminado por um proxy confiável (Railway, Cloudflare). Necessário no Railway.
TRUST_PROXY=0
# 1 = recusa login/conta sem HTTPS e marca o cookie como Secure. Use 1 no Railway.
REQUIRE_HTTPS=0

# Backup/restauração do banco por /api/admin/* (desligado se vazio). Use 32+ caracteres aleatórios.
ADMIN_TOKEN=

# Limites
MAX_ROOMS=150
# 1 (padrão) aceita progresso do solo com limites de plausibilidade; 2 = só partidas online verificadas.
STRICT_ONLINE_PROGRESS=1
# Convidados sem conta no online (apenas testes). Nunca use 1 em produção.
ALLOW_GUEST_MULTIPLAYER=0
# Reinício automático quando arquivos do servidor mudam (útil no Windows; desligado no Docker/Railway).
MIDGARD_AUTO_UPDATE=1
